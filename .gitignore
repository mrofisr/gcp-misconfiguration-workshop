# Terraform local state and provider caches
.terraform/
*.tfstate
*.tfstate.*

# Local value-bearing variable files (keep committed examples)
*.tfvars
!*.tfvars.example

# Local environment overrides (keep the committed example)
.env
.env.*
!.env.example

# OS and editor artifacts
.DS_Store
Thumbs.db

# Logs and language caches
*.log
__pycache__/
*.pyc

# Local-only OpenSpec planning artifacts (not part of the published source tree)
openspec/
